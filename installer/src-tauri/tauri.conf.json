{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SAFE_Links Installer",
  "version": "0.1.0",
  "identifier": "ng.name.safelinks.installer",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "SAFE_Links Installer",
        "width": 1200,
        "height": 820,
        "resizable": true,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}