# SAFE_Links VPS settings. deploy/vps-setup-env.sh creates .env from this
# file with strong random secrets. Never commit .env.

# Database (password is generated; the setup script also applies it to the DB)
POSTGRES_USER=safelinks_user
POSTGRES_DB=safelinks_db
POSTGRES_PASSWORD=

# Signs every login. Long random value, generated.
JWT_SECRET=

# Your super-admin login (set by the setup script, asked interactively)
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Public addresses
APP_URL=https://safelinks.name.ng
PUBLIC_API_URL=https://safelinks.name.ng

# Payments (Paystack secret key: sk_live_... or sk_test_...)
PAYSTACK_SECRET_KEY=
PLATFORM_FEE_PCT=5

# SMS / WhatsApp via Termii (optional; messages are logged without it)
TERMII_API_KEY=
TERMII_SENDER_ID=SafeLinks
TERMII_CHANNEL=generic

# Email (optional; password resets, license notices)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Google sign-in (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VITE_GOOGLE_CLIENT_ID=

BUSINESS_TZ=Africa/Lagos
BUSINESS_TZ_OFFSET=1
