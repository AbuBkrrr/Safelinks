# Copy to .env before running `docker compose up`.
# Generate a real JWT secret with: openssl rand -hex 32
JWT_SECRET=
# Any strong password — used for the Postgres container.
POSTGRES_PASSWORD=

# Optional — license-expiry-suspension emails. Leave all blank to use
# the manual fallback (a Super Admin notification with the message to
# send by hand) instead of real SMTP. See reslink-backend/README.md
# "Email sending". (Password reset doesn't use email at all — it's
# answered by a security question set at signup, entirely in-app.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Reslink <no-reply@yourdomain.com>
