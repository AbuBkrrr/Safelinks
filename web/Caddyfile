# Public deployment: Caddy must forward API requests to the backend and
# frontend assets/pages to the frontend container. WebSocket is not used by
# the portal; live state uses HTTP polling.

localhost:80 {
  handle /api/* {
    reverse_proxy backend:4000
  }
  handle /health {
    reverse_proxy backend:4000
  }
  handle {
    reverse_proxy frontend:80
  }
}

127.0.0.1:80 {
  handle /api/* {
    reverse_proxy backend:4000
  }
  handle /health {
    reverse_proxy backend:4000
  }
  handle {
    reverse_proxy frontend:80
  }
}

192.168.88.253:80 {
  handle /api/* {
    reverse_proxy backend:4000
  }
  handle /health {
    reverse_proxy backend:4000
  }
  handle {
    reverse_proxy frontend:80
  }
}

*.local:80 {
  handle /api/* {
    reverse_proxy backend:4000
  }
  handle /health {
    reverse_proxy backend:4000
  }
  handle {
    reverse_proxy frontend:80
  }
}
