.env
.env.local
*.jks
*.keystore

# OS/editor noise
.DS_Store
.idea/
*.iml

# Android local machine config
android/local.properties

web/frontend/dist/
web/backend/dist/
*.tsbuildinfo

# Installer
installer/node_modules/
installer/src-tauri/target/
installer/dist/
installer/icon-source.png

# Ignore Rust backup files
**/*.bak


# auto-generated backups
*.bak.p0
*.bak.p1*
*.bak.f1
*.bak.final
*.bak.rfix
*.bak.agentcall
surgical-scan.txt
closing-scan.txt

# Built by CI (.github/workflows/build-apps.yml) and published as releases
*.exe
*.apk
desktop/dist/
desktop/Output/
# Runtime data never belongs in git
web/backend/uploads/*
!web/backend/uploads/.gitkeep
*.sql
*.bak
*.bak-*
*.bak.*
